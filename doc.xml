<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE timeTable [
  <!ELEMENT timeTable (complexes, lessons)>
  <!ELEMENT lessons (lesson+)>
  <!ELEMENT complexes (complex+)>
  <!ELEMENT lesson (date, time)>  
  <!ELEMENT complex (name, address)>
  
  <!ATTLIST complex
      code ID #REQUIRED>
      
  <!ELEMENT name (#PCDATA)>
  <!ELEMENT address (#PCDATA)>	
  
  
  <!ATTLIST lesson
     no NMTOKEN #REQUIRED
    complex IDREF #REQUIRED>

  <!ELEMENT date (#PCDATA)>
  <!ELEMENT time (#PCDATA)>
]>

<timeTable>
    <complexes>
        <complex code="c1">
            <name>Главный корпус</name>
            <address>ул. Лесная, д. 5</address>
        </complex>
        <complex code="c2">
            <name>Второй корпус</name>
            <address>пр-т Мира, д. 10</address>
        </complex>
    </complexes>
    <lessons>
        <lesson no="1" complex="c1">
            <date>2026-09-29</date>
            <time>09:00</time>
        </lesson>
        <lesson no="2" complex="c2">
            <date>2026-09-29</date>
            <time>11:30</time>
        </lesson>
    </lessons>
</timeTable>
